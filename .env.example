# =====================================================================
# Contoh Environment Variables — E-Pilkades Kelurahan Telukan, Grogol
# ---------------------------------------------------------------------
# File ini HANYA berisi placeholder. JANGAN pernah menulis password,
# token, atau kredensial asli di sini atau di file lain yang di-commit.
# Nilai asli diisi di: Vercel → Project → Settings → Environment Variables
# (atau di .env.local untuk `vercel dev`, yang sudah di-ignore oleh Git).
# =====================================================================

# Connection string MongoDB Atlas dengan user database `soraya_render`.
# Ganti <PASSWORD_BARU> dan <CLUSTER_HOST> (mis. cluster0.abcde.mongodb.net).
# Jika password mengandung karakter khusus (@ : / ? # [ ] %), URL-encode dulu.
MONGODB_URI=mongodb+srv://soraya_render:<PASSWORD_BARU>@<CLUSTER_HOST>/pilkades_telukan?retryWrites=true&w=majority

# Nama database khusus aplikasi (default: pilkades_telukan)
MONGODB_DB=pilkades_telukan

# Token device dari dashboard Fonnte (https://md.fonnte.com) — hanya dipakai di server
FONNTE_TOKEN=<TOKEN_FONNTE>

# PIN Panel Panitia untuk API. Default 1234 bila dikosongkan.
# Disarankan diganti dengan PIN rahasia jika dipakai warga sungguhan.
ADMIN_PIN=<PIN_PANITIA>

# (Opsional) Database autentikasi user MongoDB. Default: admin (standar Atlas).
# Hanya isi jika user dibuat di database lain.
# MONGODB_AUTH_SOURCE=admin

# (Opsional) Menimpa batas waktu voting di server (format ISO 8601).
# Default: 2026-12-09T23:59:59+07:00 (lib/config.js). Hitung mundur di halaman tidak ikut berubah.
# VOTING_DEADLINE=2026-12-09T23:59:59+07:00
