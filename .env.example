# Salin ke .env.local untuk `vercel dev`, dan isi juga di Vercel → Settings → Environment Variables.
# JANGAN commit file berisi nilai asli.

# Connection string MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Nama database (opsional, default: pilkades_telukan)
MONGODB_DB=pilkades_telukan

# Token device dari dashboard Fonnte (https://md.fonnte.com) — hanya dipakai di server
FONNTE_TOKEN=isi_token_fonnte_anda

# (Opsional) PIN Panel Panitia untuk API. Default 1234 bila tidak diisi.
# ADMIN_PIN=1234
